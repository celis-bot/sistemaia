# ============================================================
#  CONFIGURACION GENERAL
# ============================================================
NODE_ENV=development
PORT=4000
# Origen permitido para CORS (separar multiples con coma)
CORS_ORIGIN=http://localhost:5173
# Nivel de log: error | warn | info | debug
LOG_LEVEL=info

# ============================================================
#  SUPABASE (base de datos + autenticacion)
#  Dashboard -> Project Settings -> API
# ============================================================
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_ANON_KEY=tu-anon-key
# SOLO backend. NUNCA exponer al frontend.
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key
# JWT secret para verificar tokens en el backend (opcional si usas JWKS de Supabase)
SUPABASE_JWT_SECRET=

# ============================================================
#  MICROSOFT 365 / TEAMS (app registration en Azure AD)
#  https://portal.azure.com -> Microsoft Entra ID -> App registrations
#  Permisos: ChannelMessage.Read.All, Files.Read.All, Team.ReadBasic.All, Group.Read.All
# ============================================================
MS_TENANT_ID=tu-tenant-id-o-common
MS_CLIENT_ID=tu-client-id
MS_CLIENT_SECRET=tu-client-secret
# ID del equipo de Teams (GUID) del que se descargan los reportes
TEAMS_TEAM_ID=
# ID del canal (opcional; si se deja vacio se listan todos los canales)
TEAMS_CHANNEL_ID=

# ============================================================
#  CONECTA UACJ (inasistencias)
# ============================================================
CONECTA_UACJ_URL=https://conecta.uacj.mx
CONECTA_USER=
CONECTA_PASS=
# Selectores CSS (ajustar segun el HTML real de Conecta)
CONECTA_USER_SELECTOR=input[name="usuario"]
CONECTA_PASS_SELECTOR=input[name="password"]
CONECTA_SUBMIT_SELECTOR=button[type="submit"]
CONECTA_TABLE_SELECTOR=table.asistencias

# ============================================================
#  PONDERACION DE DESEMPEÑO (pesos, deben sumar 1.0)
# ============================================================
WEIGHT_TASKS=0.5
WEIGHT_ATTENDANCE=0.3
WEIGHT_PUNCTUALITY=0.2

# ============================================================
#  RATE LIMIT / SEGURIDAD
# ============================================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
# Activa autenticacion local con bcrypt (alternativa a Supabase Auth)
LOCAL_AUTH_ENABLED=false
BCRYPT_ROUNDS=12

# ============================================================
#  CLUSTER / BALANCEADOR DE CARGAS
# ============================================================
# Numero de procesos worker (0 = CPUs disponibles)
CLUSTER_WORKERS=0
# URL de Redis opcional para rate-limit distribuido
REDIS_URL=
